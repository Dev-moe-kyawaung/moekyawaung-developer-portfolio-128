# Optional server-side proxy. Never place provider secrets in VITE_ variables.
# POST JSON: { messages: [{ role, content }], context: { owner, project, mode } }
# Respond with JSON: { "reply": "Assistant response" }
VITE_ASSISTANT_ENDPOINT=

# Optional contact service. Without it, the form opens a mailto draft.
# POST JSON: { name, email, subject, message }. Return a 2xx on confirmed success.
VITE_CONTACT_ENDPOINT=